<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.AndroidAssignments" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="buttonStyle">@style/CustomButtonStyle</item>
    </style>

    <style name="Theme.AndroidAssignments" parent="Theme.AppCompat.Light.DarkActionBar" />

    <style name="CustomButtonStyle" parent="Widget.AppCompat.Button">
